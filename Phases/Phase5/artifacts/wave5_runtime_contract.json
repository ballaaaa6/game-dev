{
  "schema_version": "wave5-runtime-contract-v1",
  "phase": "Phase5",
  "wave": "Wave5",
  "status": "adapter_runtime_implemented_visual_closure_pending",
  "legacy_equivalence": false,
  "state_namespaces": [
    { "name": "agent_state", "values": ["idle", "walking", "working", "sitting", "break", "talking"], "status": "web_adapter" },
    { "name": "movement_status", "values": ["idle", "moving", "arrived", "blocked", "no_path", "unavailable"], "status": "web_adapter" },
    { "name": "legacy_raw_state", "status": "evidence_only_not_exposed_as_agent_semantics" },
    { "name": "draw_selector", "fields": ["TFace", "TBody", "TMode", "TKage"], "status": "verified_signature_and_record_contract" }
  ],
  "tick": {
    "unit": "logical_tick",
    "wall_clock_equivalence": false,
    "order": ["movement", "bubble_expiry", "notification_expiry", "event_log", "render_snapshot"]
  },
  "room": {
    "manifest": "Phases/Phase5/runtime/data/room_manifest.json",
    "background": "game-dev-story-mod_Sprites/office/floor0.png",
    "seb_policy": "preserve_truncated_final_record_status",
    "coordinate_policy": "explicit_adapter_profile_not_universal_legacy_transform",
    "draw_order_policy": "deterministic_adapter_sort_not_claimed_legacy_depth"
  },
  "movement": {
    "path_provider": "injected",
    "collision_provider": "injected",
    "seat_provider": "explicit_actor_seat_ownership",
    "teleport_on_failure": false
  },
  "render": {
    "bodyface_record_count": 42,
    "body_family": "body0..body25",
    "face_family": "face_0..face_35",
    "missing_face_policy": "preserve_raw_selector_and_omit_face_layer",
    "unknown_animation_policy": "static_verified_frame_only",
    "semantic_animations_verified": 0
  },
  "dialogue": {
    "locale_artifact": "Phases/Phase5/artifacts/wave5_locale_runtime.json",
    "default_locale": "th",
    "speaker_binding": "explicit_adapter_actor_id",
    "bubble_cleanup": "delete_on_logical_expiry"
  },
  "notification": {
    "graph_id_policy": "raw_graph_id_not_decoded",
    "audio_policy": "disabled_by_default",
    "cleanup": "delete_on_logical_expiry"
  }
}
