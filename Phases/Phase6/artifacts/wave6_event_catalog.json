{
  "schema_version": "wave6-event-catalog-v1",
  "legacy_equivalence": false,
  "source": "phase6_task_system",
  "events": [
    "task.created",
    "task.assigned",
    "task.unassigned",
    "task.started",
    "task.blocked",
    "task.resumed",
    "task.completed",
    "task.notification.created",
    "task.notification.read",
    "task.notification.dismissed",
    "task.state.cleared"
  ],
  "activity_policy": "append_only_task_domain_log",
  "runtime_mirror_policy": "live_diagnostic_mirror_with_phase6_source",
  "raw_legacy_event_policy": "not_used_for_task_semantics"
}
