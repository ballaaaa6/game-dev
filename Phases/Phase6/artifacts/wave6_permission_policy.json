{
  "schema_version": "wave6-permission-policy-v1",
  "legacy_equivalence": false,
  "status": "local_explicit_policy",
  "operator_ids": ["operator"],
  "operator_actions": [
    "create",
    "assign",
    "unassign",
    "start",
    "block",
    "resume",
    "complete",
    "read_notification",
    "dismiss_notification",
    "reset",
    "import"
  ],
  "agent_actions": [
    "start",
    "block",
    "resume",
    "complete",
    "read_notification",
    "dismiss_notification"
  ],
  "agent_scope": "agent_id must equal task assignee_id or notification recipient_id",
  "authentication": "out_of_scope_local_identity_only",
  "backend_authority": "not_claimed"
}
