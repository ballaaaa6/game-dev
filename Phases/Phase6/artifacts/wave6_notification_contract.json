{
  "schema_version": "wave6-notification-contract-v1",
  "legacy_equivalence": false,
  "source": "phase6_task_system",
  "storage": "durable_in_task_snapshot",
  "expiry_policy": "no_automatic_logical_expiry",
  "statuses": ["unread", "read", "dismissed"],
  "fields": [
    "id",
    "kind",
    "task_id",
    "recipient_id",
    "text",
    "created_at_tick",
    "read_at_tick",
    "dismissed_at_tick",
    "status"
  ],
  "creation_policy": {
    "task.assigned": ["assignee_id"],
    "task.blocked": ["created_by"],
    "task.completed": ["created_by"]
  },
  "separation": {
    "wave5_notification": "ephemeral_raw_graph_notification",
    "wave6_notification": "durable_task_activity_notification",
    "message_graph": "not_reinterpreted"
  }
}
